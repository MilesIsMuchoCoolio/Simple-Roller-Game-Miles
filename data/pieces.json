body { background:#fff; color:#000; font-family:monospace; text-align:center; margin:24px; }
h1 { letter-spacing:6px; font-size:24px; margin-bottom:16px; }
canvas { border:3px solid #000; background:#fff; display:block; margin:0 auto; }
#score { font-size:18px; font-weight:bold; margin:12px 0 0; }
#message { font-size:18px; height:24px; margin:8px 0 0; }
.controls { font-size:13px; margin-top:12px; }
